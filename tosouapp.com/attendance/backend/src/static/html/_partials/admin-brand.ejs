<a class="brand" href="/admin/dashboard">
  <span class="logo-mark" aria-hidden="true">
    <img src="<%= (typeof tenant !== 'undefined' && tenant && tenant.logoUrl) ? tenant.logoUrl : '/static/images/logo1.png' %>?v=<%= appVersion %>" alt="logo" class="icon">
  </span>
  <span class="logo"><%= (typeof tenant !== 'undefined' && tenant && tenant.logoName) ? tenant.logoName : 'IIZUKA' %></span>
</a>
<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
(function() {
  try {
    // ── Tenant brand color ────────────────────────────────────────────────
    // Priority: sessionStorage (after select-tenant) > EJS server-side tenant
    var serverColor = '<%= (typeof tenant !== "undefined" && tenant && tenant.primaryColor) ? tenant.primaryColor : "#0b2c66" %>';
    var u = JSON.parse(sessionStorage.getItem('user') || '{}');
    var color = u.tenantColor || serverColor || '#0b2c66';

    // Apply to topbar
    function applyBrandColor(color) {
      var r = document.documentElement;
      r.style.setProperty('--tenant-primary', color);
      r.style.setProperty('--tenant-primary-dark', shadeColor(color, -15));
      r.style.setProperty('--tenant-primary-border', shadeColor(color, -25));
      // Text color: white for dark bg, dark for light bg
      var textColor = isLight(color) ? '#0f172a' : '#ffffff';
      r.style.setProperty('--tenant-text', textColor);
    }

    function shadeColor(hex, percent) {
      try {
        var n = parseInt(hex.replace('#',''), 16);
        var r = Math.min(255, Math.max(0, (n >> 16) + percent * 2.55 | 0));
        var g = Math.min(255, Math.max(0, ((n >> 8) & 0xff) + percent * 2.55 | 0));
        var b = Math.min(255, Math.max(0, (n & 0xff) + percent * 2.55 | 0));
        return '#' + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1);
      } catch(e) { return hex; }
    }

    function isLight(hex) {
      try {
        var n = parseInt(hex.replace('#',''), 16);
        var r = (n >> 16) & 0xff, g = (n >> 8) & 0xff, b = n & 0xff;
        // Perceived luminance
        return (r * 299 + g * 587 + b * 114) / 1000 > 128;
      } catch(e) { return false; }
    }

    applyBrandColor(color);

    // Impersonate back-link — chỉ hiện khi sysadmin đang impersonate vào tenant
    // Không hiện nếu: đang ở trang platform, hoặc đang ở admin dashboard chính (không impersonate)
    var isAdminDashboard = window.location.pathname.startsWith('/admin');
    var isPlatformPage = window.location.pathname.startsWith('/platform');
    var isSysadmin = u && (u.role === 'sysadmin' || u.role === 'superadmin' || u._sysadmin);
    if (u && u._impersonate && !isPlatformPage && !(isSysadmin && isAdminDashboard && !u._impersonatedTenantId)) {
      var bar = document.createElement('a');
      bar.href = '/platform/dashboard';
      bar.style.cssText = 'display:inline-flex;align-items:center;gap:6px;margin-left:10px;padding:3px 10px;background:#fef9c3;color:#92400e;border-radius:99px;font-size:11px;font-weight:700;text-decoration:none;border:1px solid #fde68a;';
      bar.title = 'Platformに戻る';
      bar.textContent = '⚙ Platform';
      document.currentScript.parentNode.appendChild(bar);
    }
  } catch(e) {}
})();
</script>
