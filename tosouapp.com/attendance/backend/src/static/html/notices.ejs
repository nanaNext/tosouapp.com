<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>お知らせ</title>
  <link rel="stylesheet" href="/static/css/base.css?v=navy-20260314">
  <link rel="stylesheet" href="/static/css/portal.css?v=navy-20260501-flickerfix1">
  <link rel="icon" href="data:,">
  <script src="/static/js/pages/session-idle.js?v=navy-20260403-1" defer></script>
  <script type="module" src="/static/js/pages/portal.page.js?v=20260729-notices1"></script>
  <style>
    .notices-wrap { max-width: 100%; margin: 0; padding: 8px 24px; box-sizing: border-box; }
    /* Fix topbar user section not overflowing */
    .topbar .user { margin-right: 0 !important; transform: none !important; }
    .topbar .user #userName { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 80px; }
    .notices-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
    .notices-header-left { display: flex; align-items: center; gap: 10px; }
    .notices-header-left h1 { font-size: 18px; font-weight: 800; color: #0f172a; margin: 0; }
    .notices-header-left .notices-count { background: #2563eb; color: #fff; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 99px; }
    .notices-header button { font-size: 12px; padding: 6px 12px; border: 1px solid #e2e8f0; background: #fff; border-radius: 6px; cursor: pointer; color: #64748b; }
    .notice-list { display: flex; flex-direction: column; gap: 2px; }
    .notice-item { display: flex; align-items: center; gap: 12px; padding: 14px 16px; border-radius: 10px; background: #fff; border: 1px solid #e2e8f0; transition: all 0.15s; cursor: pointer; }
    .notice-item:hover { background: #f8fafc; }
    .notice-item.unread { background: #eff6ff; border-color: #93c5fd; border-left: 4px solid #2563eb; }
    .notice-item.unread .notice-msg { font-weight: 700; color: #0f172a; }
    .notice-item:not(.unread) .notice-msg { color: #334155; }
    .notice-body { flex: 1; min-width: 0; }
    .notice-msg { font-size: 14px; color: #1e293b; line-height: 1.4; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .notice-meta { display: flex; align-items: center; gap: 8px; margin-top: 4px; }
    .notice-scope { font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 4px; }
    .notice-scope.personal { background: #eff6ff; color: #1d4ed8; }
    .notice-scope.global { background: #ecfdf5; color: #166534; }
    .notice-time { font-size: 11px; color: #94a3b8; }
    .notice-empty { text-align: center; padding: 48px 20px; color: #94a3b8; font-size: 14px; }
    .notice-item .notice-arrow { margin-left: auto; color: #94a3b8; font-size: 18px; font-weight: bold; }
    /* Detail view */
    .notice-detail-view { display: none; }
    .notice-detail-view.active { display: block; }
    .notice-back-btn { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; color: #2563eb; background: none; border: none; cursor: pointer; font-weight: 600; padding: 8px 0; margin-bottom: 16px; }
    .notice-back-btn:hover { color: #1d4ed8; }
    .notice-detail-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px; }
    .notice-detail-card .notice-detail-msg { font-size: 15px; line-height: 1.8; color: #1e293b; white-space: pre-wrap; word-break: break-all; }
    .notice-detail-card .notice-detail-msg a { color: #2563eb; text-decoration: underline; word-break: break-all; }
    .notice-detail-card .notice-detail-meta { display: flex; align-items: center; gap: 8px; margin-top: 16px; padding-top: 12px; border-top: 1px solid #f1f5f9; }
  </style>
</head>
<body>
  <%- include('_partials/employee-header.ejs') %>
  <main class="content">
    <section class="notices-wrap">
      <div id="noticesHost">
        <div class="notice-empty">読み込み中...</div>
      </div>
    </section>
  </main>
  <script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
    (async function() {
      // Get auth token - wait for portal.page.js module to set it
      const getToken = () => {
        try {
          const raw = sessionStorage.getItem('accessToken') || localStorage.getItem('accessToken');
          if (raw) return raw;
        } catch(e) {}
        return null;
      };

      // Wait for token to be available (portal.page.js module sets it via refresh())
      let token = null;
      for (let i = 0; i < 20; i++) {
        await new Promise(r => setTimeout(r, 300));
        token = getToken();
        if (token) break;
      }

      if (!token) {
        // Last resort: try cookie-based auth
      }

      const fetchAPI = async (url, opts) => {
        const t = getToken();
        const headers = { 'Content-Type': 'application/json', ...(opts?.headers || {}) };
        if (t) headers['Authorization'] = 'Bearer ' + t;
        const res = await fetch(url, { ...opts, headers, credentials: 'include' });
        if (!res.ok) throw new Error('HTTP ' + res.status);
        return res.json();
      };

      const linkify = (text) => String(text).replace(/(https?:\/\/[^\s]+)/g, '<a href="$1" target="_blank" rel="noopener">$1</a>');

      const host = document.getElementById('noticesHost');
      let allItems = [];
      try {
        const res = await fetchAPI('/api/notices?all=1&limit=50');
        allItems = Array.isArray(res?.notices) ? res.notices : [];
      } catch (e) {
        host.innerHTML = '<div class="notice-empty">読み込みに失敗しました。</div>';
        return;
      }

      const renderList = () => {
        const unreadCount = allItems.filter(it => !it.read_at).length;
        let html = '<div id="noticeListView"><div class="notices-header"><div class="notices-header-left"><h1>お知らせ</h1>';
        if (unreadCount > 0) html += '<span class="notices-count">' + unreadCount + '件未読</span>';
        html += '</div>';
        if (unreadCount > 0) html += '<button id="markAllRead" style="font-size:12px;padding:6px 12px;border:1px solid #e2e8f0;background:#fff;border-radius:6px;cursor:pointer;color:#2563eb;font-weight:600;">すべて既読にする</button>';
        html += '</div>';

        if (!allItems.length) {
          html += '<div class="notice-empty">新しいお知らせはありません。</div>';
        } else {
          const SHOW_LIMIT = 20;
          const visible = allItems.slice(0, SHOW_LIMIT);
          html += '<div class="notice-list" id="noticeList">';
          html += visible.map(function(it) {
            const isUnread = !it.read_at;
            const scope = it.audience === 'all' ? 'global' : 'personal';
            const scopeLabel = scope === 'global' ? '全体' : '個人';
            const date = String(it.created_at || '').slice(0, 16).replace('T', ' ');
            const msg = String(it.message || it.title || '');
            const shortMsg = msg.length > 50 ? msg.slice(0, 50) + '...' : msg;
            return '<div class="notice-item ' + (isUnread ? 'unread' : '') + '" data-id="' + (it.id || '') + '">' +
              '<div class="notice-body">' +
                '<div class="notice-msg">' + shortMsg.replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</div>' +
                '<div class="notice-meta">' +
                  '<span class="notice-scope ' + scope + '">' + scopeLabel + '</span>' +
                  '<span class="notice-time">' + date + '</span>' +
                '</div>' +
              '</div>' +
              '<span class="notice-arrow">›</span>' +
            '</div>';
          }).join('');
          html += '</div>';
          if (allItems.length > SHOW_LIMIT) {
            html += '<div style="text-align:center;margin-top:16px;"><button id="loadMoreNotices" style="padding:10px 24px;border:1px solid #e2e8f0;background:#fff;border-radius:8px;color:#475569;font-size:13px;font-weight:600;cursor:pointer;">もっと見る（残り' + (allItems.length - SHOW_LIMIT) + '件）</button></div>';
          }
        }
        html += '</div>';
        html += '<div id="noticeDetailView" class="notice-detail-view"></div>';
        host.innerHTML = html;
        bindListEvents();
      };

      const renderDetail = (item) => {
        const listView = document.getElementById('noticeListView');
        const detailView = document.getElementById('noticeDetailView');
        if (!listView || !detailView) return;

        const scope = item.audience === 'all' ? 'global' : 'personal';
        const scopeLabel = scope === 'global' ? '全体' : '個人';
        const date = String(item.created_at || '').slice(0, 16).replace('T', ' ');
        const msg = String(item.message || item.title || '');

        detailView.innerHTML =
          '<button class="notice-back-btn" id="noticeBackBtn">← お知らせ一覧に戻る</button>' +
          '<div class="notice-detail-card">' +
            '<div class="notice-detail-msg">' + linkify(msg) + '</div>' +
            '<div class="notice-detail-meta">' +
              '<span class="notice-scope ' + scope + '">' + scopeLabel + '</span>' +
              '<span class="notice-time">' + date + '</span>' +
            '</div>' +
          '</div>';

        listView.style.display = 'none';
        detailView.classList.add('active');

        // Back button
        document.getElementById('noticeBackBtn').addEventListener('click', function() {
          detailView.classList.remove('active');
          detailView.innerHTML = '';
          listView.style.display = '';
        });

        // Mark as read when viewing detail
        if (item.id && !item.read_at) {
          fetchAPI('/api/notices/read', { method: 'POST', body: JSON.stringify({ ids: [item.id] }) }).catch(function(){});
          item.read_at = new Date().toISOString();
          var listItem = document.querySelector('.notice-item[data-id="' + item.id + '"]');
          if (listItem) listItem.classList.remove('unread');
        }
      };

      const bindListEvents = () => {
        // Mark all read button
        var markBtn = document.getElementById('markAllRead');
        if (markBtn) {
          markBtn.addEventListener('click', async function() {
            const ids = allItems.filter(it => !it.read_at).map(it => it.id).filter(Boolean);
            if (ids.length) {
              await fetchAPI('/api/notices/read', { method: 'POST', body: JSON.stringify({ ids }) }).catch(function(){});
              allItems.forEach(it => { it.read_at = it.read_at || new Date().toISOString(); });
              document.querySelectorAll('.notice-item.unread').forEach(el => el.classList.remove('unread'));
              var badge = document.querySelector('.notices-count');
              if (badge) badge.style.display = 'none';
              markBtn.style.display = 'none';
            }
          });
        }

        // Click item to go to detail view
        document.querySelectorAll('.notice-item').forEach(function(el) {
          el.addEventListener('click', function(e) {
            if (e.target.closest('a')) return;
            const id = el.dataset.id;
            const item = allItems.find(it => String(it.id) === String(id));
            if (item) renderDetail(item);
          });
        });
      };

      renderList();
    })();
  </script>
</body>
</html>
