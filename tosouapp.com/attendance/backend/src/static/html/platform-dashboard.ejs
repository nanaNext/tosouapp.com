<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Platform Dashboard | スマートE勤怠</title>
  <link rel="stylesheet" href="/static/css/base.css?v=<%= appVersion %>">
  <link rel="icon" href="/static/images/logo1.png?v=<%= appVersion %>" type="image/png">
  <script type="module" src="/static/js/pages/platform-dashboard.page.js?v=<%= appVersion %>-3"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; min-height: 100vh;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Noto Sans JP", sans-serif;
      background: #f1f5f9; color: #0f172a; font-size: 14px; }

    /* ── Topbar ── */
    .pd-topbar {
      background: #0f172a; color: #fff;
      display: flex; align-items: center; gap: 12px;
      padding: 0 20px; height: 52px;
      position: sticky; top: 0; z-index: 100;
      box-shadow: 0 1px 4px rgba(0,0,0,.3);
    }
    .pd-topbar-logo { font-size: 18px; font-weight: 800; letter-spacing: 1px; color: #60a5fa; }
    .pd-topbar-badge {
      background: #ef4444; color: #fff; font-size: 10px; font-weight: 700;
      padding: 2px 7px; border-radius: 99px; text-transform: uppercase; letter-spacing: .5px;
    }
    .pd-topbar-spacer { flex: 1; }
    .pd-topbar-user { font-size: 13px; color: #94a3b8; }
    .pd-topbar-logout {
      background: none; border: 1px solid #334155; color: #94a3b8;
      padding: 5px 12px; border-radius: 6px; cursor: pointer; font-size: 12px;
    }
    .pd-topbar-logout:hover { border-color: #ef4444; color: #ef4444; }

    /* ── Layout ── */
    .pd-layout { display: flex; min-height: calc(100vh - 52px); }

    /* ── Sidebar ── */
    .pd-sidebar {
      width: 200px; flex-shrink: 0;
      background: #1e293b; padding: 16px 0;
      position: sticky; top: 52px; height: calc(100vh - 52px); overflow-y: auto;
    }
    .pd-nav-item {
      display: block; padding: 10px 20px; color: #94a3b8;
      text-decoration: none; font-size: 13px; font-weight: 500;
      transition: background .15s, color .15s; cursor: pointer;
      border: none; background: none; width: 100%; text-align: left;
    }
    .pd-nav-item:hover, .pd-nav-item.active { background: #0f172a; color: #fff; }
    .pd-nav-item.active { border-left: 3px solid #60a5fa; }
    .pd-nav-section {
      font-size: 10px; color: #475569; text-transform: uppercase;
      letter-spacing: 1px; padding: 16px 20px 6px; font-weight: 700;
    }

    /* ── Main content ── */
    .pd-main { flex: 1; padding: 24px; overflow-y: auto; }

    /* ── Stats row ── */
    .pd-stats { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 14px; margin-bottom: 24px; }
    .pd-stat-card {
      background: #fff; border-radius: 10px; padding: 18px 20px;
      box-shadow: 0 1px 3px rgba(0,0,0,.07);
    }
    .pd-stat-label { font-size: 12px; color: #64748b; margin-bottom: 6px; }
    .pd-stat-value { font-size: 28px; font-weight: 800; color: #0f172a; line-height: 1; }
    .pd-stat-sub { font-size: 11px; color: #94a3b8; margin-top: 4px; }

    /* ── Section header ── */
    .pd-section-header {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 14px;
    }
    .pd-section-title { font-size: 16px; font-weight: 700; }
    .pd-btn {
      padding: 7px 16px; border-radius: 7px; border: none; cursor: pointer;
      font-size: 13px; font-weight: 600; transition: opacity .15s;
    }
    .pd-btn:hover { opacity: .85; }
    .pd-btn-primary { background: #1976d2; color: #fff; }
    .pd-btn-sm { padding: 4px 10px; font-size: 12px; border-radius: 5px; }
    .pd-btn-danger { background: #fee2e2; color: #dc2626; }
    .pd-btn-ghost { background: #f1f5f9; color: #0f172a; border: 1px solid #e2e8f0; }
    .pd-btn-enter { background: #dcfce7; color: #16a34a; }

    /* ── Tenant table ── */
    .pd-table-wrap { background: #fff; border-radius: 10px; box-shadow: 0 1px 3px rgba(0,0,0,.07); overflow: hidden; }
    table.pd-table { width: 100%; border-collapse: collapse; }
    .pd-table th { background: #f8fafc; font-size: 12px; color: #64748b; font-weight: 600;
      text-align: left; padding: 10px 14px; border-bottom: 1px solid #e2e8f0; }
    .pd-table td { padding: 12px 14px; border-bottom: 1px solid #f1f5f9; vertical-align: middle; }
    .pd-table tr:last-child td { border-bottom: none; }
    .pd-table tr:hover td { background: #f8fafc; }

    /* ── Status badge ── */
    .badge { display: inline-block; padding: 2px 8px; border-radius: 99px; font-size: 11px; font-weight: 700; }
    .badge-active { background: #dcfce7; color: #16a34a; }
    .badge-suspended { background: #fee2e2; color: #dc2626; }
    .badge-trial { background: #fef9c3; color: #ca8a04; }
    .badge-basic { background: #eff6ff; color: #1d4ed8; }
    .badge-pro { background: #faf5ff; color: #7c3aed; }

    /* ── Tenant logo ── */
    .td-logo { display: flex; align-items: center; gap: 12px; }
    .td-logo img {
      width: 48px; height: 48px;
      object-fit: contain;
      border-radius: 8px;
      background: #fff;
      padding: 4px;
      border: 1px solid #e2e8f0;
      box-shadow: 0 1px 3px rgba(0,0,0,.08);
      flex-shrink: 0;
      display: block;
    }
    .td-logo-placeholder {
      width: 48px; height: 48px; border-radius: 8px; flex-shrink: 0;
      background: linear-gradient(135deg, #1976d2, #0d47a1);
      display: flex; align-items: center; justify-content: center;
      font-size: 18px; font-weight: 800; color: #fff;
      border: 1px solid #e2e8f0;
    }
    .td-name { font-weight: 600; font-size: 13px; }
    .td-slug { font-size: 11px; color: #94a3b8; }
    .td-address { font-size: 11px; color: #64748b; margin-top: 2px; }
    .td-phone { font-size: 11px; color: #64748b; }
    .td-license { font-size: 11px; color: #64748b; }

    /* ── Modal ── */
    .pd-modal-backdrop {
      position: fixed; inset: 0; background: rgba(0,0,0,.4);
      display: flex; align-items: center; justify-content: center;
      z-index: 1000; padding: 16px;
    }
    .pd-modal-backdrop[hidden] { display: none; }
    .pd-modal {
      background: #fff; border-radius: 12px; padding: 28px;
      width: 100%; max-width: 480px;
      box-shadow: 0 20px 60px rgba(0,0,0,.2);
    }
    .pd-modal-title { font-size: 17px; font-weight: 700; margin: 0 0 20px; }
    .pd-form-row { margin-bottom: 14px; }
    .pd-form-row label { display: block; font-size: 12px; color: #64748b; font-weight: 600; margin-bottom: 5px; }
    .pd-form-row input, .pd-form-row select {
      width: 100%; padding: 8px 11px; border: 1px solid #e2e8f0;
      border-radius: 7px; font-size: 13px; background: #f8fafc;
    }
    .pd-form-row input:focus, .pd-form-row select:focus {
      outline: none; border-color: #1976d2; background: #fff;
      box-shadow: 0 0 0 2px rgba(25,118,210,.15);
    }
    .pd-modal-footer { display: flex; gap: 10px; justify-content: flex-end; margin-top: 20px; }

    /* ── Error / loading ── */
    #pd-error { display:none; color: #dc2626; background: #fff0f0; border: 1px solid #fecdd3;
      border-radius: 7px; padding: 10px 14px; margin-bottom: 16px; font-size: 13px; }
    .pd-loading { text-align: center; padding: 40px; color: #94a3b8; font-size: 14px; }

    /* ── Search bar ── */
    .pd-search-bar {
      display: flex; gap: 10px; margin-bottom: 14px; flex-wrap: wrap;
    }
    .pd-search-bar input[type="search"] {
      flex: 1; min-width: 200px; padding: 8px 12px;
      border: 1px solid #e2e8f0; border-radius: 7px;
      font-size: 13px; background: #fff;
    }
    .pd-search-bar select {
      padding: 8px 10px; border: 1px solid #e2e8f0; border-radius: 7px;
      font-size: 13px; background: #fff; min-width: 140px;
    }
    .pd-search-bar input:focus, .pd-search-bar select:focus {
      outline: none; border-color: #1976d2;
    }

    /* ── Assign modal user search ── */
    .pd-assign-results {
      border: 1px solid #e2e8f0; border-radius: 7px;
      background: #fff; max-height: 180px; overflow-y: auto;
      margin-top: 4px; box-shadow: 0 4px 12px rgba(0,0,0,.08);
      position: relative; z-index: 10;
    }
    .pd-assign-result-item {
      padding: 9px 12px; cursor: pointer; font-size: 13px;
      display: flex; flex-direction: column; gap: 2px;
      border-bottom: 1px solid #f1f5f9;
    }
    .pd-assign-result-item:last-child { border-bottom: none; }
    .pd-assign-result-item:hover { background: #eff8ff; }
    .pd-assign-result-name { font-weight: 600; color: #0f172a; }
    .pd-assign-result-email { font-size: 11px; color: #64748b; }
    .pd-selected-user {
      padding: 8px 12px; background: #f0fdf4; border: 1px solid #bbf7d0;
      border-radius: 7px; margin-top: 4px; font-size: 13px;
      display: flex; justify-content: space-between; align-items: center;
    }
    .pd-selected-user button {
      background: none; border: none; cursor: pointer;
      color: #64748b; font-size: 16px; padding: 0 4px; line-height: 1;
    }

    /* ── Tenant tags in user table ── */
    .pd-tenant-tag {
      display: inline-flex; align-items: center; gap: 5px;
      background: #eff6ff; color: #1d4ed8; border-radius: 5px;
      padding: 2px 7px; font-size: 11px; font-weight: 600;
      margin: 2px; white-space: nowrap;
    }
    .pd-tenant-tag .role-label {
      background: #dbeafe; border-radius: 3px; padding: 1px 5px;
      font-size: 10px; color: #1e40af;
    }
    .pd-tenant-tag button {
      background: none; border: none; cursor: pointer;
      color: #94a3b8; font-size: 13px; padding: 0; line-height: 1;
    }
    .pd-tenant-tag button:hover { color: #dc2626; }

    /* ── Tabs ── */
    .pd-tabs { display: flex; gap: 0; border-bottom: 2px solid #e2e8f0; margin-bottom: 20px; }
    .pd-tab {
      padding: 9px 18px; font-size: 13px; font-weight: 600; color: #64748b;
      border: none; background: none; cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -2px;
    }
    .pd-tab.active { color: #1976d2; border-bottom-color: #1976d2; }

    /* ── Section panels ── */
    .pd-panel { display: none; }
    .pd-panel.active { display: block; }

    @media (max-width: 640px) {
      .pd-sidebar { display: none; }
      .pd-stats { grid-template-columns: 1fr 1fr; }
    }
  </style>
</head>
<body>
  <!-- Topbar -->
  <header class="pd-topbar">
    <span class="pd-topbar-logo">⚙ PLATFORM</span>
    <span class="pd-topbar-badge">NTN</span>
    <span class="pd-topbar-spacer"></span>
    <span class="pd-topbar-user" id="pd-user-name">読み込み中...</span>
    <button class="pd-topbar-logout" id="pd-logout-btn" type="button">ログアウト</button>
  </header>

  <div class="pd-layout">
    <!-- Sidebar -->
    <nav class="pd-sidebar">
      <div class="pd-nav-section">Platform</div>
      <button class="pd-nav-item active" data-panel="tenants">🏢 テナント管理</button>
      <button class="pd-nav-item" data-panel="users">👥 全ユーザー</button>
      <div class="pd-nav-section">System</div>
      <button class="pd-nav-item" data-panel="audit">📋 監査ログ</button>
      <button class="pd-nav-item" data-panel="settings">⚙ 設定</button>
    </nav>

    <!-- Main -->
    <main class="pd-main">
      <div id="pd-error"></div>

      <!-- Stats -->
      <div class="pd-stats" id="pd-stats">
        <div class="pd-stat-card">
          <div class="pd-stat-label">アクティブテナント</div>
          <div class="pd-stat-value" id="stat-tenants">—</div>
          <div class="pd-stat-sub">会社数</div>
        </div>
        <div class="pd-stat-card" id="card-users" style="cursor:pointer;" title="クリックで一覧を表示">
          <div class="pd-stat-label">全ユーザー</div>
          <div class="pd-stat-value" id="stat-users">—</div>
          <div class="pd-stat-sub">アクティブ</div>
        </div>
        <div class="pd-stat-card" id="card-checkins" style="cursor:pointer;" title="クリックで一覧を表示">
          <div class="pd-stat-label">本日の打刻</div>
          <div class="pd-stat-value" id="stat-checkins">—</div>
          <div class="pd-stat-sub">チェックイン</div>
        </div>
      </div>

      <!-- Tenants panel -->
      <div class="pd-panel active" id="panel-tenants">
        <div class="pd-section-header">
          <span class="pd-section-title">テナント一覧</span>
          <button class="pd-btn pd-btn-primary" id="pd-add-tenant-btn" type="button">+ 新規テナント</button>
        </div>
        <div class="pd-table-wrap">
          <div class="pd-loading" id="pd-tenants-loading">読み込み中...</div>
          <table class="pd-table" id="pd-tenants-table" style="display:none">
            <thead>
              <tr>
                <th>会社名</th>
                <th>プラン</th>
                <th>状態</th>
                <th>ユーザー数</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody id="pd-tenants-tbody"></tbody>
          </table>
        </div>
      </div>

      <!-- Users panel -->
      <div class="pd-panel" id="panel-users">
        <div class="pd-section-header">
          <span class="pd-section-title">ユーザー管理</span>
          <button class="pd-btn pd-btn-primary" id="pd-assign-user-btn" type="button">+ ユーザーをテナントに割り当て</button>
        </div>
        <!-- Search + Filter bar -->
        <div class="pd-search-bar">
          <input type="search" id="pd-users-search" placeholder="名前・メールで検索..." autocomplete="off">
          <select id="pd-users-tenant-filter">
            <option value="">全テナント</option>
          </select>
          <select id="pd-users-role-filter">
            <option value="">全ロール</option>
            <option value="admin">管理者</option>
            <option value="manager">マネージャー</option>
            <option value="employee">従業員</option>
            <option value="hr">人事</option>
            <option value="payroll">給与</option>
          </select>
        </div>
        <div class="pd-table-wrap">
          <div class="pd-loading" id="pd-users-loading">読み込み中...</div>
          <table class="pd-table" id="pd-users-table" style="display:none">
            <thead>
              <tr>
                <th>名前</th>
                <th>メール</th>
                <th>DB ロール</th>
                <th>所属テナント / ロール</th>
                <th>状態</th>
                <th>操作</th>
              </tr>
            </thead>
            <tbody id="pd-users-tbody"></tbody>
          </table>
          <div id="pd-users-empty" style="display:none;text-align:center;padding:32px;color:#94a3b8;font-size:14px;">
            該当するユーザーが見つかりません
          </div>
        </div>
      </div>

      <!-- Audit panel -->
      <div class="pd-panel" id="panel-audit">
        <div class="pd-section-header">
          <span class="pd-section-title">監査ログ</span>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;align-items:flex-end;">
          <label style="font-size:12px;color:#475569;">
            アクション
            <select id="audit-filter-action" style="display:block;margin-top:4px;padding:6px 10px;border:1px solid #cbd5e1;border-radius:6px;font-size:13px;">
              <option value="">すべて</option>
              <option value="login_success">ログイン</option>
              <option value="logout">ログアウト</option>
              <option value="checkin">チェックイン</option>
              <option value="checkout">チェックアウト</option>
              <option value="attendance_month_bulk">勤怠月次保存</option>
              <option value="platform_impersonate">Impersonate</option>
              <option value="platform_create_tenant">テナント作成</option>
              <option value="admin_attendance_update">勤怠修正</option>
              <option value="password_change">パスワード変更</option>
            </select>
          </label>
          <label style="font-size:12px;color:#475569;">
            From
            <input type="date" id="audit-filter-from" style="display:block;margin-top:4px;padding:6px 10px;border:1px solid #cbd5e1;border-radius:6px;font-size:13px;">
          </label>
          <label style="font-size:12px;color:#475569;">
            To
            <input type="date" id="audit-filter-to" style="display:block;margin-top:4px;padding:6px 10px;border:1px solid #cbd5e1;border-radius:6px;font-size:13px;">
          </label>
          <button type="button" id="audit-filter-btn" class="pd-btn pd-btn-sm pd-btn-primary" style="height:34px;">検索</button>
        </div>
        <div class="pd-table-wrap">
          <table class="pd-table" id="audit-table" style="display:none;">
            <thead>
              <tr>
                <th>日時</th>
                <th>ユーザーID</th>
                <th>アクション</th>
                <th>パス</th>
                <th>メソッド</th>
                <th>IP</th>
              </tr>
            </thead>
            <tbody id="audit-tbody"></tbody>
          </table>
          <div id="audit-loading" class="pd-loading">読み込み中...</div>
          <div id="audit-empty" class="pd-loading" style="display:none;">ログがありません</div>
          <div id="audit-pager" style="display:flex;justify-content:center;align-items:center;gap:12px;padding:12px 0;font-size:13px;"></div>
        </div>
      </div>

      <!-- Settings panel -->
      <div class="pd-panel" id="panel-settings">
        <div class="pd-section-header">
          <span class="pd-section-title">システム設定</span>
        </div>
        <div style="max-width:720px;display:flex;flex-direction:column;gap:16px;" id="pd-settings-container">

          <!-- パスワードポリシー -->
          <div style="background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:20px;">
            <h4 style="margin:0 0 12px;font-size:15px;color:#0f172a;display:flex;align-items:center;gap:8px;">🔐 パスワードポリシー</h4>
            <p style="font-size:13px;color:#64748b;margin:0 0 14px;">全ユーザーに適用されるパスワード要件を設定します。</p>
            <form id="pd-form-pw-policy" style="display:flex;flex-direction:column;gap:10px;">
              <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                <label style="font-size:13px;font-weight:600;color:#374151;min-width:100px;">最小文字数</label>
                <input id="pd-pw-min" type="number" min="4" max="128" value="8" style="width:80px;height:32px;padding:0 8px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;" />
              </div>
              <div style="display:flex;flex-direction:column;gap:6px;">
                <label style="font-size:13px;font-weight:600;color:#374151;">複雑さ要件</label>
                <div style="display:flex;flex-wrap:wrap;gap:8px 16px;padding-left:4px;">
                  <label style="font-size:13px;color:#475569;display:flex;align-items:center;gap:5px;cursor:pointer;"><input type="checkbox" id="pd-pw-upper" checked style="accent-color:#2563eb;"> 大文字 (A-Z)</label>
                  <label style="font-size:13px;color:#475569;display:flex;align-items:center;gap:5px;cursor:pointer;"><input type="checkbox" id="pd-pw-lower" checked style="accent-color:#2563eb;"> 小文字 (a-z)</label>
                  <label style="font-size:13px;color:#475569;display:flex;align-items:center;gap:5px;cursor:pointer;"><input type="checkbox" id="pd-pw-digit" checked style="accent-color:#2563eb;"> 数字 (0-9)</label>
                  <label style="font-size:13px;color:#475569;display:flex;align-items:center;gap:5px;cursor:pointer;"><input type="checkbox" id="pd-pw-symbol" style="accent-color:#2563eb;"> 記号 (!@#$)</label>
                </div>
              </div>
              <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                <label style="font-size:13px;font-weight:600;color:#374151;min-width:100px;">有効期限（日）</label>
                <input id="pd-pw-expiry" type="number" min="0" max="365" value="0" style="width:80px;height:32px;padding:0 8px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;" />
                <span style="font-size:11px;color:#94a3b8;">0=無期限</span>
              </div>
              <div style="display:flex;align-items:center;gap:10px;margin-top:6px;">
                <button type="submit" class="pd-btn pd-btn-sm pd-btn-primary">保存</button>
                <span id="pd-pw-result" style="font-size:13px;"></span>
              </div>
            </form>
          </div>

          <!-- 2FA トグル -->
          <div style="background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:20px;">
            <h4 style="margin:0 0 12px;font-size:15px;color:#0f172a;display:flex;align-items:center;gap:8px;">🔑 二要素認証 (2FA)</h4>
            <p style="font-size:13px;color:#64748b;margin:0 0 14px;">全ユーザーに2FA（パスキー認証）を強制するかどうかを設定します。</p>
            <div style="display:flex;align-items:center;gap:12px;">
              <label style="font-size:13px;font-weight:500;color:#374151;flex:1;">全ユーザーに2FAを強制する</label>
              <label style="position:relative;display:inline-block;width:44px;height:24px;flex-shrink:0;">
                <input type="checkbox" id="pd-toggle-2fa" style="opacity:0;width:0;height:0;">
                <span id="pd-toggle-2fa-slider"></span>
              </label>
              <span id="pd-2fa-status" style="font-size:12px;font-weight:700;color:#94a3b8;min-width:30px;">OFF</span>
            </div>
            <style>
              #pd-toggle-2fa-slider { position:absolute; cursor:pointer; top:0; left:0; right:0; bottom:0; background:#cbd5e1; border-radius:24px; transition:background .25s; }
              #pd-toggle-2fa-slider::before { content:''; position:absolute; width:18px; height:18px; left:3px; bottom:3px; background:#fff; border-radius:50%; transition:transform .25s; box-shadow:0 1px 3px rgba(0,0,0,.2); }
              #pd-toggle-2fa:checked + #pd-toggle-2fa-slider { background: #2563eb; }
              #pd-toggle-2fa:checked + #pd-toggle-2fa-slider::before { transform: translateX(20px); }
            </style>
          </div>

          <!-- メール送信テスト -->
          <div style="background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:20px;">
            <h4 style="margin:0 0 12px;font-size:15px;color:#0f172a;display:flex;align-items:center;gap:8px;">📧 メール送信テスト</h4>
            <p style="font-size:13px;color:#64748b;margin:0 0 14px;">メール設定が正しく動作しているか確認します。自分のアドレスにテストメールを送信します。</p>
            <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
              <button type="button" id="pd-test-mail" class="pd-btn pd-btn-sm pd-btn-primary">テストメールを送信</button>
              <span id="pd-test-mail-result" style="font-size:13px;"></span>
            </div>
          </div>

          <!-- メンテナンスモード -->
          <div style="background:#fff;border:1px solid #e2e8f0;border-left:4px solid #f59e0b;border-radius:12px;padding:20px;">
            <h4 style="margin:0 0 12px;font-size:15px;color:#0f172a;display:flex;align-items:center;gap:8px;">🚧 メンテナンスモード</h4>
            <p style="font-size:13px;color:#64748b;margin:0 0 14px;">ONにすると給与明細アップロード/ダウンロード等が一時停止します。</p>
            <div style="display:flex;flex-direction:column;gap:10px;">
              <div style="display:flex;align-items:center;gap:12px;">
                <label style="font-size:13px;font-weight:500;color:#374151;flex:1;">メンテナンスモード</label>
                <label style="position:relative;display:inline-block;width:44px;height:24px;flex-shrink:0;">
                  <input type="checkbox" id="pd-toggle-maintenance" style="opacity:0;width:0;height:0;">
                  <span class="pd-toggle-slider"></span>
                </label>
                <span id="pd-maintenance-status" style="font-size:12px;font-weight:700;color:#94a3b8;min-width:30px;">OFF</span>
              </div>
              <div style="display:flex;align-items:center;gap:12px;">
                <label style="font-size:13px;font-weight:500;color:#374151;flex:1;">スーパー管理者以外ログイン禁止</label>
                <label style="position:relative;display:inline-block;width:44px;height:24px;flex-shrink:0;">
                  <input type="checkbox" id="pd-toggle-lock-login" style="opacity:0;width:0;height:0;">
                  <span class="pd-toggle-slider"></span>
                </label>
                <span id="pd-lock-login-status" style="font-size:12px;font-weight:700;color:#94a3b8;min-width:30px;">OFF</span>
              </div>
            </div>
          </div>

          <!-- GPS要件 -->
          <div style="background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:20px;">
            <h4 style="margin:0 0 12px;font-size:15px;color:#0f172a;display:flex;align-items:center;gap:8px;">📍 GPS要件</h4>
            <p style="font-size:13px;color:#64748b;margin:0 0 14px;">出退勤時にGPS位置情報の取得を必須にするかどうかを設定します。<br><span style="font-size:12px;">※ どこからでも打刻可能です。位置情報は記録用であり、場所の制限ではありません。</span></p>
            <div style="display:flex;flex-direction:column;gap:10px;">
              <div style="display:flex;align-items:center;gap:12px;">
                <label style="font-size:13px;font-weight:500;color:#374151;flex:1;">GPS位置情報を必須にする</label>
                <label style="position:relative;display:inline-block;width:44px;height:24px;flex-shrink:0;">
                  <input type="checkbox" id="pd-toggle-gps" checked style="opacity:0;width:0;height:0;">
                  <span class="pd-toggle-slider"></span>
                </label>
                <span id="pd-gps-status" style="font-size:12px;font-weight:700;color:#16a34a;min-width:30px;">ON</span>
              </div>
              <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                <label style="font-size:13px;font-weight:600;color:#374151;min-width:160px;">GPS精度の許容範囲（m）</label>
                <input id="pd-gps-accuracy" type="number" min="10" max="5000" value="500" style="width:90px;height:32px;padding:0 8px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;" />
                <span style="font-size:11px;color:#94a3b8;">値が大きいほど緩い（通常50m以下）</span>
              </div>
              <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                <label style="font-size:13px;font-weight:600;color:#374151;min-width:160px;">許可国コード</label>
                <input id="pd-gps-countries" type="text" placeholder="空欄＝制限なし" style="width:200px;height:32px;padding:0 8px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;" />
                <span style="font-size:11px;color:#94a3b8;">例: JP,VN</span>
              </div>
            </div>
          </div>

          <!-- リモートポリシー -->
          <div style="background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:20px;">
            <h4 style="margin:0 0 12px;font-size:15px;color:#0f172a;display:flex;align-items:center;gap:8px;">🏠 リモートワークポリシー</h4>
            <p style="font-size:13px;color:#64748b;margin:0 0 14px;">在宅勤務・リモート打刻のルールを設定します。</p>
            <div style="display:flex;flex-direction:column;gap:10px;">
              <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                <label style="font-size:13px;font-weight:600;color:#374151;min-width:120px;">ポリシー</label>
                <select id="pd-remote-policy" style="height:32px;padding:0 8px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;min-width:180px;">
                  <option value="anywhere">どこからでも (anywhere)</option>
                  <option value="office_only">オフィスのみ (office_only)</option>
                  <option value="hybrid">ハイブリッド (hybrid)</option>
                </select>
              </div>
              <div style="display:flex;align-items:center;gap:12px;">
                <label style="font-size:13px;font-weight:500;color:#374151;flex:1;">リモート打刻時にメモ必須</label>
                <label style="position:relative;display:inline-block;width:44px;height:24px;flex-shrink:0;">
                  <input type="checkbox" id="pd-toggle-note-remote" style="opacity:0;width:0;height:0;">
                  <span class="pd-toggle-slider"></span>
                </label>
                <span id="pd-note-remote-status" style="font-size:12px;font-weight:700;color:#94a3b8;min-width:30px;">OFF</span>
              </div>
              <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                <label style="font-size:13px;font-weight:600;color:#374151;min-width:120px;">最大デバイス数</label>
                <input id="pd-max-devices" type="number" min="1" max="20" value="5" style="width:70px;height:32px;padding:0 8px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;" />
              </div>
            </div>
          </div>

          <!-- フラグ保存 -->
          <div style="background:#f8fafc;border:1px dashed #cbd5e1;border-radius:12px;padding:16px 20px;">
            <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
              <button type="button" id="pd-save-flags" class="pd-btn pd-btn-primary">フラグ設定を保存</button>
              <span id="pd-flags-result" style="font-size:13px;"></span>
            </div>
            <p style="margin:6px 0 0;font-size:12px;color:#64748b;">メンテナンスモード・GPS要件・リモートポリシーの変更を一括保存します。</p>
          </div>

          <!-- シフトリマインダー -->
          <div style="background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:20px;">
            <h4 style="margin:0 0 8px;font-size:15px;color:#0f172a;">⏰ シフトリマインダー</h4>
            <p style="font-size:13px;color:#64748b;margin:0;">毎日23:00 JST（打刻リマインダー）、15:00 JST（シフト提出リマインダー: 15日/25日/月末）</p>
          </div>
        </div>
        <style>
          .pd-toggle-slider { position:absolute; cursor:pointer; top:0; left:0; right:0; bottom:0; background:#cbd5e1; border-radius:24px; transition:background .25s; }
          .pd-toggle-slider::before { content:''; position:absolute; width:18px; height:18px; left:3px; bottom:3px; background:#fff; border-radius:50%; transition:transform .25s; box-shadow:0 1px 3px rgba(0,0,0,.2); }
          input[type="checkbox"]:checked + .pd-toggle-slider { background: #2563eb !important; }
          input[type="checkbox"]:checked + .pd-toggle-slider::before { transform: translateX(20px); }
        </style>
      </div>
    </main>
  </div>

  <!-- Modal: Assign User to Tenant -->
  <div class="pd-modal-backdrop" id="pd-assign-modal" hidden>
    <div class="pd-modal">
      <h2 class="pd-modal-title">ユーザーをテナントに割り当て</h2>
      <form id="pd-assign-form" novalidate>
        <input type="hidden" id="pd-assign-existing-tenant-id">
        <input type="hidden" id="pd-assign-user-id-hidden">
        <div class="pd-form-row">
          <label>ユーザー検索 *</label>
          <input type="search" id="pd-assign-user-search" placeholder="名前またはメールを入力..." autocomplete="off">
          <div id="pd-assign-user-results" class="pd-assign-results" style="display:none"></div>
          <div id="pd-assign-selected-user" class="pd-selected-user" style="display:none"></div>
        </div>
        <div class="pd-form-row">
          <label>テナント（会社）*</label>
          <select id="pd-assign-tenant-select" required>
            <option value="">選択してください</option>
          </select>
        </div>
        <div class="pd-form-row">
          <label>ロール *</label>
          <select id="pd-assign-role-select" required>
            <option value="employee">従業員 (employee)</option>
            <option value="manager">マネージャー (manager)</option>
            <option value="admin">管理者 (admin)</option>
            <option value="hr">人事 (hr)</option>
            <option value="payroll">給与担当 (payroll)</option>
          </select>
        </div>
        <div id="pd-assign-error" style="color:#dc2626;font-size:12px;margin-bottom:8px;display:none"></div>
        <div class="pd-modal-footer">
          <button type="button" class="pd-btn pd-btn-ghost" id="pd-assign-cancel">キャンセル</button>
          <button type="submit" class="pd-btn pd-btn-primary" id="pd-assign-submit">割り当て</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Create / Edit Tenant -->
  <div class="pd-modal-backdrop" id="pd-tenant-modal" hidden>
    <div class="pd-modal">
      <h2 class="pd-modal-title" id="pd-modal-title">新規テナント</h2>
      <form id="pd-tenant-form" novalidate>
        <input type="hidden" id="pd-tenant-id">
        <div class="pd-form-row">
          <label>会社名 *</label>
          <input type="text" id="pd-f-name" placeholder="飯塚塗研株式会社" required>
        </div>
        <div class="pd-form-row">
          <label>スラッグ * (英数字・ハイフン)</label>
          <input type="text" id="pd-f-slug" placeholder="iizuka" pattern="[a-z0-9\-]+" required>
        </div>
        <div class="pd-form-row">
          <label>ロゴ名 (ナビバーに表示)</label>
          <input type="text" id="pd-f-logo-name" placeholder="IIZUKA">
        </div>
        <div class="pd-form-row">
          <label>ロゴ URL</label>
          <input type="text" id="pd-f-logo-url" placeholder="/static/images/logo1.png">
        </div>
        <div class="pd-form-row">
          <label>プラン</label>
          <select id="pd-f-plan">
            <option value="trial">Trial</option>
            <option value="basic" selected>Basic</option>
            <option value="pro">Pro</option>
            <option value="enterprise">Enterprise</option>
          </select>
        </div>
        <div class="pd-form-row">
          <label>状態</label>
          <select id="pd-f-status">
            <option value="active">Active</option>
            <option value="suspended">Suspended</option>
            <option value="cancelled">Cancelled</option>
          </select>
        </div>
        <div id="pd-form-error" style="color:#dc2626;font-size:12px;margin-bottom:8px;display:none"></div>
        <div class="pd-modal-footer">
          <button type="button" class="pd-btn pd-btn-ghost" id="pd-modal-cancel">キャンセル</button>
          <button type="submit" class="pd-btn pd-btn-primary" id="pd-modal-submit">保存</button>
        </div>
      </form>
    </div>
  </div>
</body>
</html>
